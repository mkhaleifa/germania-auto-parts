generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  phone         String?
  role          UserRole   @default(USER)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  accounts      Account[]
  addresses     Address[]
  orders        Order[]
  sessions      Session[]
  wishlist      Wishlist[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String?
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String
  country      String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  products    Product[]
}

model Product {
  id                  String              @id @default(cuid())
  title               String
  slug                String              @unique
  description         String
  price               Decimal             @db.Decimal(10, 0)
  comparePrice        Decimal?            @db.Decimal(10, 0)
  currency            String              @default("USD")
  condition           ProductCondition
  status              ProductStatus       @default(DRAFT)
  stock               Int                 @default(0)
  sku                 String?             @unique
  brand               String?
  weight              Decimal?            @db.Decimal(8, 2)
  dimensions          String?
  material            String?
  donorVehicle        String?
  donorMileage        Int?
  testingStatus       String?
  conditionNotes      String?
  categoryId          String
  specs               Json?
  tags                String[]
  isFeatured          Boolean             @default(false)
  lowStockAlertSentAt DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  orderItems          OrderItem[]
  partNumbers         PartNumber[]
  category            Category            @relation(fields: [categoryId], references: [id])
  images              ProductImage[]
  vehicles            ProductVehicle[]
  stockNotifications  StockNotification[]
  reservations        StockReservation[]
  wishlistedBy        Wishlist[]

  @@index([categoryId])
  @@index([condition])
  @@index([status])
  @@index([price])
  @@index([brand])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([status, categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model PartNumber {
  id        String         @id @default(cuid())
  productId String
  number    String
  type      PartNumberType
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, number])
  @@index([number])
}

model Vehicle {
  id         String           @id @default(cuid())
  make       String
  model      String
  yearStart  Int
  yearEnd    Int
  generation String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  products   ProductVehicle[]

  @@unique([make, model, yearStart, yearEnd])
  @@index([make])
  @@index([make, model])
}

model ProductVehicle {
  id        String  @id @default(cuid())
  productId String
  vehicleId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  @@unique([productId, vehicleId])
  @@index([vehicleId])
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  userId            String?
  status            OrderStatus   @default(PENDING)
  subtotal          Decimal       @db.Decimal(10, 0)
  shippingCost      Decimal       @default(0) @db.Decimal(10, 0)
  tax               Decimal       @default(0) @db.Decimal(10, 0)
  total             Decimal       @db.Decimal(10, 0)
  currency          String        @default("USD")
  shippingName      String
  shippingPhone     String
  shippingAddress   String
  shippingCity      String
  shippingState     String?
  shippingZip       String
  shippingCountry   String
  paymentMethod     PaymentMethod @default(STRIPE)
  stripeSessionId   String?       @unique
  stripePaymentId   String?
  bankTransferProof String?
  paymentVerifiedAt DateTime?
  paymentExpiresAt  DateTime?
  trackingNumber    String?
  trackingCarrier   String?
  customerNote      String?
  adminNote         String?
  guestEmail        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User?         @relation(fields: [userId], references: [id])
  items             OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([guestEmail])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  title     String
  image     String?
  price     Decimal  @db.Decimal(10, 0)
  quantity  Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model StockReservation {
  id              String   @id @default(cuid())
  productId       String
  stripeSessionId String
  quantity        Int
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  product         Product  @relation(fields: [productId], references: [id])

  @@unique([stripeSessionId, productId])
  @@index([expiresAt])
  @@index([stripeSessionId])
}

model OrderCounter {
  date    String @id
  counter Int    @default(0)
}

model StockNotification {
  id         String    @id @default(cuid())
  productId  String
  email      String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  product    Product   @relation(fields: [productId], references: [id])

  @@unique([email, productId])
  @@index([productId])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  token          String    @unique @default(cuid())
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  @@index([email])
}

model ContactInquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    ContactStatus @default(UNREAD)
  adminNote String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum ProductCondition {
  NEW
  GRADE_A
  GRADE_B
  GRADE_C
  GRADE_D
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum UserRole {
  USER
  ADMIN
}

enum PartNumberType {
  OEM
  AFTERMARKET
  MANUFACTURER
}

enum PaymentMethod {
  STRIPE
  BANK_TRANSFER
}

enum ContactStatus {
  UNREAD
  READ
  REPLIED
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}
